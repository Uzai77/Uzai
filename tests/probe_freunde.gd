extends "res://tests/probe_base.gd"
## Probe Freunde: Liste in der Seitenleiste (Steam, Discord), Freund-Aktionen, Profil in Uzai,
## Chat (Blasen, Link, Senden, Tippen, Antwort), Link aufs Handy, Anmeldung.


func run() -> void:
	Config.set_value("theme.preset", "uzai")
	Config.set_value("theme.corners", "rund")
	Config.set_value("theme.cover_shape", "hoch")
	Config.set_value("accounts.discord_servers", [])
	await wait(0.6)
	main.goto("friends", "steam")
	await shot("01_freunde_steam", 1.4)
	await press("down")
	await shot("02_freunde_jonas", 1.2)
	await press("down", 2)
	await shot("03_freunde_lea", 1.2)
	await press("down", 6)
	await shot("04_freunde_offline", 1.2)
	await press("up", 9)
	main.goto("friends", "discord:1")
	await shot("05_discord_kanal", 1.0)
	await press("down")
	await shot("06_discord_person", 0.9)
	await press("right")
	await shot("06b_discord_beitreten", 0.5)
	await press("a")
	await shot("06c_discord_guide", 1.0)
	main.toggle_guide()
	await wait(0.6)
	main.goto("friends", "steam")
	await wait(0.6)
	main.open_friend(Social.steam_friends[0], "steam")
	await shot("07_aktionen_steam", 0.8)
	await press("b")
	await wait(0.4)
	main.open_friend(Social.discord["1"].members[1], "discord", "1")
	await shot("08_aktionen_discord", 0.8)
	await press("b")
	await wait(0.4)
	var prof = load("res://src/ui/layers/friend_profile.gd").new()
	prof.friend = Social.steam_friends[0]
	main.open_layer(prof)
	await shot("09_profil", 1.4)
	await press("down")
	await shot("10_profil_reiter", 0.7)
	await press("down")
	await shot("10b_profil_zuletzt", 0.8)
	await press("rb")
	await shot("11_profil_gemeinsam", 0.9)
	await press("b")
	await wait(0.4)
	var prof2 = load("res://src/ui/layers/friend_profile.gd").new()
	prof2.friend = Social.steam_friends[6]
	main.open_layer(prof2)
	await shot("12_profil_privat", 1.2)
	await press("b")
	await wait(0.4)
	main.open_chat(Social.steam_friends[0])
	await shot("13_chat", 1.4)
	var chat = Nav.top_layer()
	await press("up", 2)
	await shot("14_chat_auswahl", 0.6)
	await press("up", 2)
	await shot("15_chat_link", 0.6)
	await press("y")
	await shot("16_link_handy", 0.9)
	await press("b")
	await wait(0.3)
	await press("up", 7)
	await shot("16b_chat_tage", 0.7)
	await press("down", 12)
	chat._send("Bin in zehn Minuten da!")
	await shot("17_chat_gesendet", 0.25)
	await shot("18_chat_tippt", 1.6)
	await shot("19_chat_antwort", 2.6)
	await press("b")
	await wait(0.4)
	SteamChat.demo = false
	main.open_chat(Social.steam_friends[2])
	await shot("20_chat_anmelden", 1.6)
	await press("b")
	await wait(0.4)
	Social.send_steam(str(Social.steam_friends[1].id), "Hör mal: To Zanarkand – Nobuo Uematsu https://open.spotify.com/track/4uLU6hMCjMI75M1A2tKUQC")
	await shot("20b_wartende_nachricht", 1.6)
	await press("b")
	SteamChat.demo = true
	await wait(0.4)
	var link = load("res://src/ui/layers/chat_link.gd").new()
	link.info = load("res://src/ui/layers/chat_link.gd").link_info("https://www.reddit.com/r/Eldenring/comments/abc/bester_build/")
	main.open_layer(link)
	await shot("21_link_web", 0.8)
	await press("b")
	await wait(0.3)
	var keep: Array = Social.steam_friends
	Social.steam_friends = []
	main.friends_view().build()
	await shot("22_laden", 0.6)
	Social.steam_error = "Steam antwortet gerade nicht."
	main.friends_view().build()
	await shot("23_fehler", 0.5)
	Social.steam_error = ""
	Social.steam_friends = keep
	main.friends_view().build()
	await wait(0.3)
	# Mit echtem Spielbild (wie die Spielseiten-Probe): UZAI_DEMO_ART=<ordner mit hero.jpg>
	var art := OS.get_environment("UZAI_DEMO_ART")
	if art != "":
		var g := Library.get_game("steam:1245620")
		g["images"] = { "hero": art.path_join("hero.jpg"), "logo": art.path_join("logo.png") }
		Media.forget(g)
		var prof3 = load("res://src/ui/layers/friend_profile.gd").new()
		prof3.friend = Social.steam_friends[0]
		main.open_layer(prof3)
		await shot("24_profil_mit_bild", 2.2)
		await press("b")
		await wait(0.4)
		main.goto("friends", "steam")
		await wait(0.4)
		await press("down")
		await press("up")
		await shot("25_freunde_mit_bild", 2.0)

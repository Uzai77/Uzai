e Runde dauert 22 Minuten – dein Wissen bleibt</li><li>Keine Kampfsysteme, keine Erfahrungspunkte: Neugier ist dein einziges Werkzeug</li></ul>","supported_languages":"Englisch<strong>*</strong>, Französisch, Italienisch, Deutsch, Spanisch – Spanien, Japanisch, Koreanisch, Polnisch, Portugiesisch – Brasilien, Russisch, Chinesisch (vereinfacht), Türkisch<br><strong>*</strong>Sprachausgabe in dieser Sprache","developers":["Mobius Digital"],"publishers":["Annapurna Interactive"],"price_overview":{"currency":"EUR","initial":2499,"final":1249,"discount_percent":50,"initial_formatted":"24,99€","final_formatted":"12,49€"},"package_groups":[{"name":"default","title":"Outer Wilds kaufen","subs":[{"packageid":336209,"percent_savings_text":"-50% ","percent_savings":0,"option_text":"Outer Wilds - <span class=\"discount_original_price\">24,99€</span> 12,49€","is_free_license":false,"price_in_cents_with_discount":1249},{"packageid":600001,"percent_savings_text":"-35% ","percent_savings":0,"option_text":"Outer Wilds: Archaeologist Edition - <span class=\"discount_original_price\">34,99€</span> 22,74€","is_free_license":false,"price_in_cents_with_discount":2274}]}],"platforms":{"windows":true,"mac":false,"linux":false},"metacritic":{"score":85},"categories":[{"id":2,"description":"Einzelspieler"},{"id":22,"description":"Steam-Errungenschaften"},{"id":28,"description":"Volle Controllerunterstützung"},{"id":23,"description":"Steam Cloud"}],"genres":[{"id":"25","description":"Abenteuer"},{"id":"23","description":"Indie"}],"screenshots":[{"id":0,"path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/753640/ss_demo0.600x338.jpg","path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/753640/ss_demo0.1920x1080.jpg"},{"id":1,"path_thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/753640/ss_demo1.600x338.jpg","path_full":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/753640/ss_demo1.1920
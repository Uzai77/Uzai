; Uzai – Konsolen-Oberfläche für Windows-PCs.
; Godot 4.5, Renderer "Forward+" (Vulkan) für das Zimmer (GI, SSAO, Reflexionen); ohne Vulkan fällt Godot
; von selbst auf "Compatibility" zurück (rendering_device/fallback_to_opengl3), Mobile und Web bleiben dort.

config_version=5

[application]

config/name="Uzai"
config/description="Konsolen-Oberfläche für Windows-PCs"
config/version="0.16.92"
run/main_scene="res://src/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Uzai"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.0204, 0.0216, 0.0251, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/windows_native_icon="res://assets/uzai.ico"

[autoload]

Config="*res://src/core/config.gd"
Remote="*res://src/core/remote.gd"
UzTheme="*res://src/core/uz_theme.gd"
Icons="*res://src/core/icons.gd"
Toasts="*res://src/ui/toasts.gd"
Sfx="*res://src/core/sfx.gd"
Net="*res://src/core/net.gd"
Media="*res://src/core/media.gd"
Helper="*res://src/core/helper.gd"
Library="*res://src/library/library.gd"
Launcher="*res://src/core/launcher.gd"
Achievements="*res://src/core/achievements.gd"
Social="*res://src/core/social.gd"
SteamCM="*res://src/core/steam_cm.gd"
SteamChat="*res://src/core/steam_chat.gd"
Voice="*res://src/core/voice.gd"
DiscordChat="*res://src/core/discord_chat.gd"
Music="*res://src/core/music.gd"
Store="*res://src/core/store.gd"
YouTube="*res://src/core/youtube.gd"
Video="*res://src/core/video.gd"
Twitch="*res://src/core/twitch.gd"
Quellen="*res://src/core/medienquellen.gd"
Movies="*res://src/core/movies.gd"
NuvioSync="*res://src/core/nuvio_sync.gd"
Lossless="*res://src/core/lossless.gd"
Nav="*res://src/core/nav.gd"
MusicPresence="*res://src/core/music_presence.gd"
Notify="*res://src/core/notify.gd"
Unlocks="*res://src/core/unlocks.gd"
Discs="*res://src/core/discs.gd"
Capture="*res://src/core/capture.gd"
Pads="*res://src/core/pads.gd"
Installs="*res://src/core/installs.gd"
Badges="*res://src/core/badges.gd"
Mixer="*res://src/core/mixer.gd"
Undo="*res://src/core/undo.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true
timers/tooltip_delay_sec=99999.0

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/fallback_to_opengl3=true
rendering_device/fallback_to_d3d12=true
rendering_device/pipeline_cache/enable=true
anti_aliasing/quality/use_debanding=true
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.0392157, 0.0470588, 0.0705882, 1)
2d/snap/snap_2d_transforms_to_pixel=true

[audio]

general/text_to_speech=true
